Screen {
    layout: vertical;
    background: #0b1020;
    color: #d8dee9;
}

#product-header {
    height: 3;
    padding: 1 2;
    background: #151d33;
    color: #8fbcbb;
    text-style: bold;
    text-overflow: ellipsis;
}

#product-body {
    height: 1fr;
}

#session-sidebar {
    width: 30;
    min-width: 24;
    border-right: solid #334155;
    background: #111827;
    padding: 0 1;
}

.panel-title {
    height: 2;
    padding-top: 1;
    color: #88c0d0;
    text-style: bold;
}

#session-filter {
    height: 3;
    margin-bottom: 1;
}

#session-list {
    height: 1fr;
}

.sidebar-help {
    height: 2;
    color: #64748b;
}

#main-panel {
    width: 1fr;
    height: 1fr;
}

#conversation {
    height: 1fr;
    overflow-y: auto;
    padding: 1 2;
}

#empty-state {
    width: 100%;
    height: auto;
    min-height: 8;
    padding: 2 3;
    color: #94a3b8;
    border: round #334155;
}

#conversation-markdown {
    width: 100%;
    height: auto;
}

#streaming-text {
    width: 100%;
    height: auto;
    padding: 1 0;
    color: #d8dee9;
}

#activity-panel {
    width: 100%;
    height: auto;
    color: #a7c7e7;
    padding: 0 1;
}

#composer {
    height: 6;
    min-height: 4;
    border-top: solid #334155;
    background: #111827;
}

#composer:focus {
    border-top: solid #88c0d0;
}

#status-bar {
    height: 1;
    padding: 0 1;
    background: #151d33;
    color: #94a3b8;
    text-overflow: ellipsis;
}

Footer {
    height: 1;
}

ConfirmScreen, TextPromptScreen, HelpScreen, ManagementScreen {
    align: center middle;
}

#confirm-dialog, #prompt-dialog {
    grid-size: 2;
    grid-gutter: 1 2;
    grid-rows: 1fr 3;
    padding: 1 2;
    width: 60;
    height: 11;
    border: thick #334155;
    background: #111827;
}

#confirm-question, #prompt-dialog > Label {
    column-span: 2;
}

#help-dialog {
    width: 80%;
    height: 80%;
    padding: 1 2;
    border: thick #334155;
    background: #111827;
}

#management-dialog {
    width: 80%;
    height: 75%;
    padding: 1 2;
    border: thick #334155;
    background: #111827;
}

.compact #product-header {
    height: 2;
    padding: 0 1;
}

.compact #composer {
    height: 5;
}
